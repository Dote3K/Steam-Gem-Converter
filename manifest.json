{
  "manifest_version": 3,
  "name": "Steam Gem Converter",
  "version": "1.0.0",
  "description": "Convert selected Steam inventory items into gems.",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "action": {
    "default_title": "Steam Gem Converter",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://steamcommunity.com/id/*/inventory*", "https://steamcommunity.com/profiles/*/inventory*"],
      "js": ["bridge/page-context.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://steamcommunity.com/id/*/inventory*", "https://steamcommunity.com/profiles/*/inventory*"],
      "js": ["content/inventory.js", "content/steam-api.js", "content/runtime.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
