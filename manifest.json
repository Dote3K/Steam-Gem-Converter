{
  "manifest_version": 3,
  "name": "Steam Gem Converter",
  "version": "1.1.0",
  "description": "Convert selected Steam inventory items into gems.",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Steam Gem Converter",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://steamcommunity.com/id/*/inventory*", "https://steamcommunity.com/profiles/*/inventory*"],
      "js": ["bridge/page-context.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://steamcommunity.com/id/*/inventory*", "https://steamcommunity.com/profiles/*/inventory*"],
      "js": ["content/inventory.js", "content/steam-api.js", "content/runtime.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
